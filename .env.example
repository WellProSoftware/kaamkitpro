# Public Supabase project configuration. These values are intended for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only billing configuration. Never use NEXT_PUBLIC_ for secrets.
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Test is the safe default. Live mode additionally requires RAZORPAY_LIVE_PAYMENTS_ENABLED=true.
RAZORPAY_MODE=test
RAZORPAY_LIVE_PAYMENTS_ENABLED=false

# Comma-separated admin allowlist; use the exact verified Supabase account email(s).
# Without an allowlisted email, the admin grant panel returns 403.
KAAMKITPRO_ADMIN_EMAILS=
